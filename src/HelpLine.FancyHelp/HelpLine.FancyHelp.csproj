<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HelpLine.FancyHelp</AssemblyName>
    <RootNamespace>HelpLine.FancyHelp</RootNamespace>
    <PackageId>HelpLine.FancyHelp</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <Description>Spectre.Console-powered colorized help output for System.CommandLine.</Description>
    <PackageTags>System.CommandLine;Help;CLI;Spectre;Color</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ConsoleDetection.cs" Link="Shared\ConsoleDetection.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\artwork\package-icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>
